# ── NiyamAI Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values

# Groq API key (required for LLM generation)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LLM model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model (local, downloaded automatically on first run)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Cross-encoder reranker model (local)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# BM25 index path
BM25_INDEX_PATH=./data/bm25_index.pkl

# Raw PDF directory
PDF_DIR=./Directories

# Processed chunks Output
CHUNKS_DIR=./data/chunks

# Chunking strategy: "fixed" or "section_aware"
CHUNKING_STRATEGY=section_aware

# Chunk size in tokens (for fixed chunking)
CHUNK_SIZE=400

# Chunk overlap in tokens (for fixed chunking)
CHUNK_OVERLAP=80

# Top-K for initial retrieval (per index)
RETRIEVAL_K=20

# Top-K after reranking (sent to LLM)
RERANK_TOP_K=5

# Evaluation dataset path
EVAL_DATASET_PATH=./data/eval_set.json

# FastAPI host/port
API_HOST=0.0.0.0
API_PORT=8000
